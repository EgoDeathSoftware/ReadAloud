# Copy to .env and fill in values for remote TTS mode.
# Not needed for local-gpu / local-cpu modes (defaults to http://kokoro:8880).

READALOUD_TTS_BASE_URL=https://your-remote-tts-server.com

# API key for the upstream TTS server. Leave blank for self-hosted Kokoro;
# required for hosted providers such as OpenAI or Groq.
READALOUD_TTS_API_KEY=

# Optional overrides (these are the defaults)
# READALOUD_TTS_MODEL=kokoro
# READALOUD_TTS_DEFAULT_VOICE=af_heart
# READALOUD_MAX_CHUNK_CHARS=4000
